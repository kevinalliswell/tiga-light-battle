{
  "name": "tiga-light-battle",
  "description": "A child-friendly procedural Three.js Ultraman Tiga battle game.",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinalliswell/tiga-light-battle.git"
  },
  "bugs": {
    "url": "https://github.com/kevinalliswell/tiga-light-battle/issues"
  },
  "homepage": "https://github.com/kevinalliswell/tiga-light-battle#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
